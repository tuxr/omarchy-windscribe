{
  "schemaVersion": 1,
  "id": "io.github.dsumpter.windscribe",
  "name": "Windscribe",
  "version": "1.1.0",
  "author": "Darius Sumpter",
  "license": "MIT",
  "description": "Windscribe VPN status, locations, protocol, and firewall in the Omarchy bar via windscribe-cli.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Windscribe",
    "description": "Toggle the Windscribe tunnel, pick a location, and manage protocol or firewall from the bar.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 30,
      "defaultProtocol": "Auto"
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 10,
        "max": 3600,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "defaultProtocol",
        "type": "enum",
        "label": "Connect protocol",
        "options": [
          "Auto",
          "WireGuard",
          "UDP",
          "TCP",
          "Stealth",
          "WStunnel"
        ],
        "defaultValue": "Auto",
        "description": "Passed to windscribe-cli on connect. Auto uses the CLI's last / preferred protocol."
      }
    ]
  }
}
